<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="online_retail.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1059"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="online_retail" custom_title="0" dock_id="1" table="4,13:mainonline_retail"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- Day 6: Query 1 - Daily Revenue &amp; Running Total
-- ============================================================
WITH DailySales AS (
    SELECT 
        SUBSTR(InvoiceDate, 1, 10) AS SaleDate,
        SUM(Quantity * Price) AS DailyRevenue
    FROM online_retail
    WHERE Quantity &gt; 0 AND Price &gt; 0
    GROUP BY SaleDate
)
SELECT 
    SaleDate,
    ROUND(DailyRevenue, 2) AS DailyRevenue,
    ROUND(SUM(DailyRevenue) OVER (ORDER BY SaleDate), 2) AS RunningTotalRevenue
FROM DailySales
ORDER BY SaleDate;</sql><sql name="SQL 2*">-- Day 6: Query 2 - Customer Spending Rank using Window Functions
-- ============================================================
WITH CustomerSpending AS (
    SELECT 
        &quot;Customer ID&quot; AS CustomerID,
        Country,
        SUM(Quantity * Price) AS TotalSpent,
        COUNT(DISTINCT Invoice) AS TotalOrders
    FROM online_retail
    WHERE &quot;Customer ID&quot; IS NOT NULL AND Quantity &gt; 0 AND Price &gt; 0
    GROUP BY &quot;Customer ID&quot;, Country
)
SELECT 
    CustomerID,
    Country,
    ROUND(TotalSpent, 2) AS TotalSpent,
    TotalOrders,
    RANK() OVER (ORDER BY TotalSpent DESC) AS SpendingRank
FROM CustomerSpending
LIMIT 20;</sql><current_tab id="1"/></tab_sql></sqlb_project>
